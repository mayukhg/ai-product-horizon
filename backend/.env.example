DATABASE_URL=postgresql://horizonai:horizonai_dev@localhost:5432/horizonai
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
GOLDEN_DATASET_PATH=golden_dataset.json

# LLM mode: mock (default, no API keys) or live (real inference)
LLM_MODE=mock

# Smart Intern — local Ollama / vLLM
SMART_INTERN_BASE_URL=http://127.0.0.1:11434/v1
SMART_INTERN_MODEL=llama3.3:70b
SMART_INTERN_API_KEY=ollama

# PhD Reasoner + Judge — OpenRouter (provide key when enabling live PhD/judge calls)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PHD_REASONER_MODEL=anthropic/claude-sonnet-4
PHD_REASONER_ESCALATION_MODEL=anthropic/claude-opus-4
JUDGE_MODEL=anthropic/claude-sonnet-4

# Embeddings — local (384-dim, matches pgvector schema)
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama

# Guardrails — local Llama Guard
GUARDRAIL_BASE_URL=http://127.0.0.1:11434/v1
GUARDRAIL_MODEL=llama-guard3:8b
GUARDRAIL_API_KEY=ollama

# Eval release gates
EVAL_GROUNDEDNESS_BLOCK_THRESHOLD=0.90
EVAL_GROUNDEDNESS_WARN_THRESHOLD=0.92
EVAL_PASS_RATE_BLOCK_THRESHOLD=0.93
EVAL_PASS_RATE_WARN_THRESHOLD=0.95

# API auth (separate from OpenRouter)
AUTH_REQUIRED=false
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=horizonai-api
